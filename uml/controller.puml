@startuml
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho

package controller {
    package server {
        class ServerController {
            - [static] instance : ServerController
            - networkServer : NetworkServer
            - waitingLobbies : Map<String, LobbyController>
            - runningLobbies : Map<String, LobbyController>
            - clients: Map<String, VirtualClient>

            + [static] getInstance() : ServerController
            + broadcast(response : Response) : void
            + addClient(client : VirtualClient) : void
            + createLobby(clientID :int, playerNum : int, playerName : String, totem: Totem) : void
            + joinLobby(clientID :int, lobbyID : int, playerName : String, totem: Totem) : void
            + leaveLobby(clientID : int, lobbyID : int) : void
            + startLobby(clientID : int, lobbyID : int) : void
            + getWaitingLobbies(clientID : int) : void
            + getLobbyInfo(clientID : int, lobbyID : int) : void
            + getRank(clientID : int, lobbyID : int) : void
            + getLeaderboard(clientID : int, playerNum : int) : void
            + requestPick(clientID: int, lobbyID: int, topPicks : List<Card>, bottomPicks : List<Card>) : void
        }

        class LobbyController {
            - id : int
            - model : Game
            - clients : Map<VirtualClient, String>

            + broadcast(response : Response) : void
            + addPlayer(client : VirtualClient, playerName : String, totem: Totem) : void
            + removePlayer(client : VirtualClient) : void
            + setName(name : String) : void
            + setID(id : int) : void
            + getModel() : Game
            + pickCards(clientID : int, topPicks : List<Card>, bottomPicks : List<Card>)
        }

        package network {
            class ClientHandler {
                - clientInterface : ClientTCPInterface
                - socket : Socket
                - gson : Gson

                + run() : void
                + sendMessage(response : Response) : void
            }

            class ClientTCPInterface {
                - clientHandler : ClientHandler

                + handleMessage(request : Request) : void
                + setWaitingLobbies(clientID : int, lobbies : List<Lobby>) : void
                + showLobbyInfo(clientID : int, lobby : Lobby) : void
                + setLobby(clientID : int, lobbyID : int, playerName : String, totem : Totem) : void
                + removeFromLobby(clientID : int, lobbyID : int) : void
                + showRank(clientID : int, rankings : Map<Integer, Integer>) : void
                + showLeaderboard(clientID : int, leaderboard : List<LeaderboardEntry>) : void
                + confirmPick(clientID: int, topPicks : List<Card>, bottomPicks : List<Card>) : void
            }

            class NetworkServer {
                - ip : String
                - tcpPort: int
                - rmiPort: int
                - serverSocket : ServerSocket
                - serverController : ServerController

                + run() : void
            }
        }
    }

    package client {
        class ClientController {
            - view : View
            - server : VirtualServer

            + connectRMI(registryName : String, ip : String, rmiPort : int) : void
            + connectTCP(ip : String, tcpPort : int) : void

            + setWaitingLobbies(clientID : int, lobbies : List<Lobby>) : void
            + showLobbyInfo(clientID : int, lobby : Lobby) : void
            + setLobby(clientID : int, lobbyID : int, playerName : String, totem : Totem) : void
            + removeFromLobby(clientID : int, lobbyID : int) : void
            + showRank(clientID : int, rankings : Map<Integer, Integer>) : void
            + showLeaderboard(clientID : int, leaderboard : List<LeaderboardEntry>) : void
            + confirmPick(clientID: int, topPicks : List<Card>, bottomPicks : List<Card>) : void
        }

        package model {
            class ClientModel {
                - tribes : Map<Integer, ClientTribe>
                - orderTile :
                - offerTrack :
                - topRow : List<>
                - bottomRow :
            }

            class ClientTribe {
                - food : int
                - pp : int
                - stars : int
                - buildingDiscount : int
                - sustenanceDiscount : int
                - characters : List<AbstractCard>
                - buildings : List<AbstractBuilding>
            }
        }

        package network {
            class ServerTCPInterface {
                - clientController : ClientController
                - serverHandler : NetworkClient

                + handleMessage(response : Response) : void
                + addClient(client : VirtualClient) : void
                + createLobby(clientID :int, playerNum : int, playerName : String, totem: Totem) : void
                + joinLobby(clientID :int, lobbyID : int, playerName : String, totem: Totem) : void
                + leaveLobby(clientID : int, lobbyID : int) : void
                + startLobby(clientID : int, lobbyID : int) : void
                + getWaitingLobbies(clientID : int) : void
                + getLobbyInfo(clientID : int, lobbyID : int) : void
                + getRank(clientID : int, lobbyID : int) : void
                + getLeaderboard(clientID : int, playerNum : int) : void
                + requestPick(clientID: int, lobbyID: int, topPicks : List<Card>, bottomPicks : List<Card>) : void
            }

            class NetworkClient {
                - serverInterface : ServerTCPInterface
                - socket : Socket
                - gson : Gson

                + run() : void
                + sendMessage(request : Request) : void
                + connect(ip : String, tcpPort : int)
            }
        }
    }

    package common {
        abstract class VirtualClient {
            - id : int

            + setWaitingLobbies(clientID : int, lobbies : List<Lobby>) : void
            + showLobbyInfo(clientID : int, lobby : Lobby) : void
            + setLobby(clientID : int, lobbyID : int, playerName : String, totem : Totem) : void
            + removeFromLobby(clientID : int, lobbyID : int) : void
            + showRank(clientID : int, rankings : Map<Integer, Integer>) : void
            + showLeaderboard(clientID : int, leaderboard : List<LeaderboardEntry>) : void
            + confirmPick(clientID: int, topPicks : List<Card>, bottomPicks : List<Card>) : void
        }

        abstract class VirtualServer {
            + createLobby(clientID :int, playerNum : int, playerName : String, totem: Totem) : void
            + joinLobby(clientID :int, lobbyID : int, playerName : String, totem: Totem) : void
            + leaveLobby(clientID : int, lobbyID : int) : void
            + startLobby(clientID : int, lobbyID : int) : void
            + getWaitingLobbies(clientID : int) : void
            + getLobbyInfo(clientID : int, lobbyID : int) : void
            + getRank(clientID : int, lobbyID : int) : void
            + getLeaderboard(clientID : int, playerNum : int) : void
            + requestPick(clientID: int, lobbyID: int, topPicks : List<Card>, bottomPicks : List<Card>) : void
        }

        class LeaderboardEntry {
            - playerName : String
            - points : int
            - date : Date
            - playerNum : int
        }

        class Lobby {
            - lobbyID : int
            - size : int
            - players : Map<Integer, PlayerID>
            - model : ClientModel
        }

        class PlayerID {
            - name : String
            - totem : Totem
        }

        package messages {
            abstract class Message {
                - type : MessageType
                - clientID : int
            }

            enum MessageType {
                PICK_CARDS
                CREATE_LOBBY
                JOIN_LOBBY
                LEAVE_LOBBY
                START_LOBBY
                WAITING_LOBBY
                LOBBY_INFO
                GET_RANK
                GET_LEADERBOARD
                SET_ID
            }

            package requests {
                abstract class Request {
                    + receive(serverController : ServerController) : void
                }

                class PickCardsRequest {
                    - lobbyID : int
                    - topRowPicks : List<Card>
                    - bottomRowPicks : List<Card>

                    + receive(serverController : ServerController) : void
                }

                class CreateLobbyRequest {
                    - playerName : String
                    - totem: Totem

                    + receive(serverController : ServerController) : void
                }

                class JoinLobbyRequest {
                    - lobbyID : int
                    - playerName : String
                    - totem: Totem

                    + receive(serverController : ServerController) : void
                }

                class LeaveLobbyRequest {
                    - lobbyID : int

                    + receive(serverController : ServerController) : void
                }

                class StartLobbyRequest {
                    - lobbyID : int

                    + receive(serverController : ServerController) : void
                }

                class WaitingLobbyRequest {
                    + receive(serverController : ServerController) : void
                }

                class LobbyInfoRequest {
                    - lobbyID : int

                    + receive(serverController : ServerController) : void
                }

                class GetRankRequest {
                    - lobbyID : int

                    + receive(serverController : ServerController) : void
                }

                class GetLeaderboardRequest {
                    + receive(serverController : ServerController) : void
                }
            }

            package responses {
                abstract class Response {
                    + receive(clientController : ClientController) : void
                }

                class PickCardsResponse {
                    - lobbyID : int
                    - topRowPicks : List<Card>
                    - bottomRowPicks : List<Card>

                    + receive(clientController : ClientController) : void
                }

                class JoinLobbyResponse {
                    - lobbyID : int
                    - playerName : String
                    - totem: Totem

                    + receive(clientController : ClientController) : void
                }

                class LeaveLobbyResponse {
                    - lobbyID : int

                    + receive(clientController : ClientController) : void
                }

                class StartLobbyResponse {
                    - lobbyID : int

                    + receive(clientController : ClientController) : void
                }

                class WaitingLobbyResponse {
                    - lobbies : Map<String, Integer>

                    + receive(clientController : ClientController) : void
                }

                class LobbyInfoResponse {
                    - lobby : Lobby

                    + receive(clientController : ClientController) : void
                }

                class GetRankResponse {
                    - lobbyID : int
                    - ranking : Map<String, Integer>

                    + receive(clientController : ClientController) : void
                }

                class GetLeaderboardResponse {
                    - leaderboard : Leaderboard

                    + receive(clientController : ClientController) : void
                }

                class SetIDResponse {
                    + receive(clientController : ClientController) : void
                }
            }
        }
    }
}

' -----------------------------------
' Associations
' -----------------------------------

VirtualClient <|.. ClientController
VirtualClient <|.. ClientTCPInterface
VirtualServer <|.. ServerController
VirtualServer <|.. ServerTCPInterface

Request -|> Message
Response -|> Message

PickCardsRequest -|> Request
CreateLobbyRequest -|> Request
JoinLobbyRequest -|> Request
LeaveLobbyRequest -|> Request
WaitingLobbyRequest -|> Request
LobbyInfoRequest -|> Request
GetRankRequest -|> Request
GetLeaderboardRequest -|> Request

PickCardsResponse -|> Response
JoinLobbyResponse -|> Response
LeaveLobbyResponse -|> Response
WaitingLobbyResponse -|> Response
LobbyInfoResponse -|> Response
GetRankResponse -|> Response
GetLeaderboardResponse -|> Response
SetIDResponse-|> Response

' -----------------------------------
' Layout
' -----------------------------------


@enduml