@startuml
skinparam style strictuml

participant Registry
participant ClientController
participant RMIClientService
participant RMIServerInterface
participant ConnectionMonitor
participant RMIClientInterface
participant RMIServerService
participant ServerController
participant LobbyController
participant LobbyState

activate ClientController
ClientController -> ClientController : connectRMI(IP, Port)
ClientController -> ClientController: getRegistry(IP, Port)
ClientController -> Registry: lookup(Name)

ClientController-> RMIClientService : new RMIClientService()
ClientController-> ClientController : exportObject(RMIClientService)
ClientController-> RMIServerInterface : new RMIServerInterface()
ClientController-> RMIServerInterface : registerClient(RMIClientService)
deactivate ClientController

activate RMIServerInterface
RMIServerInterface -> RMIServerService: registerClient(Client)
deactivate RMIServerInterface

activate RMIServerService
RMIServerService -> ServerController: submitCPUTask()
deactivate RMIServerService

activate ServerController
ServerController -> ConnectionMonitor: registerClient(RMIClientInterface))
ServerController -> ServerController: randomUUID()
ServerController -> RMIClientInterface: setID(String)
deactivate ServerController

activate RMIClientInterface
RMIClientInterface -> RMIClientService: setID(String)
deactivate RMIClientInterface

activate RMIClientService
RMIClientService -> ClientController: submitCPUTask()
deactivate RMIClientService

activate ClientController
ClientController -> ConnectionMonitor: startServerMonitor(ClientController)
deactivate ClientController

alt login
ClientController -> RMIServerInterface: login(ID, Username)

activate RMIServerInterface
RMIServerInterface -> RMIServerService: login(ID, Username)
deactivate RMIServerInterface

activate RMIServerService
RMIServerService -> ServerController: submitCPUTask()
deactivate RMIServerService

activate ServerController
ServerController -> RMIClientInterface: confirmLogin(Username)

activate RMIClientInterface
RMIClientInterface -> RMIClientService: confirmLogin(Username)
deactivate RMIClientInterface

activate RMIClientService
RMIClientService -> ClientController: submitCPUTask()
deactivate RMIClientService

ServerController -> RMIClientInterface: showWaitingLobbies(Lobbies)

activate RMIClientInterface
RMIClientInterface -> RMIClientService: showWaitingLobbies(Response)
deactivate RMIClientInterface

activate RMIClientService
RMIClientService -> ClientController: submitCPUTask()
deactivate RMIClientService

deactivate ServerController

else Invalid Username

ServerController -> RMIClientInterface: showError(Error)

activate RMIClientInterface
RMIClientInterface -> RMIClientService: showError(Error)
deactivate RMIClientInterface

activate RMIClientService
RMIClientService -> ClientController: submitCPUTask()
deactivate RMIClientService

end

alt Joining a game lobby
    ClientController -> RMIServerInterface : getLobbyInfo(LobbyID)

    activate RMIServerInterface
    RMIServerInterface -> RMIServerService: getLobbyInfo(LobbyID)
    deactivate RMIServerInterface

    activate RMIServerService
    RMIServerService -> ServerController: submitCPUTask()
    deactivate RMIServerService

    activate ServerController
    ServerController -> LobbyController: getLobbyInfo(Client)
    deactivate ServerController

    activate LobbyController
    LobbyController -> LobbyState: getLobbyInfo(Client)
    deactivate LobbyController

    activate LobbyState
    LobbyState -> LobbyController : addListener(Client)
    LobbyState -> RMIClientInterface: showLobbyInfo(Players)
    deactivate LobbyState

    activate RMIClientInterface
    RMIClientInterface -> RMIClientService: showLobbyInfo(Players)
    deactivate RMIClientInterface

    activate RMIClientService
    RMIClientService -> ClientController: submitCPUTask()
    deactivate RMIClientService

    ClientController -> RMIServerInterface : joinLobby(LobbyID, Totem)

    activate RMIServerInterface
    RMIServerInterface -> RMIServerService: joinLobby(LobbyID, Totem)
    deactivate RMIServerInterface

    activate RMIServerService
    RMIServerService -> ServerController: submitCPUTask()
    deactivate RMIServerService

    activate ServerController
    ServerController -> LobbyController: joinLobby(Client, Player)
    deactivate ServerController

    activate LobbyController
    LobbyController -> LobbyState: joinLobby(Client, Player)
    deactivate LobbyController

    activate LobbyState
    LobbyState -> LobbyState : validatePlayerInfo(Player)
    LobbyState -> RMIClientInterface: addPlayer(Player)

    activate RMIClientInterface
    RMIClientInterface -> RMIClientService: addPlayer(Player)
    deactivate RMIClientInterface

    activate RMIClientService
    RMIClientService -> ClientController: submitCPUTask()
    deactivate RMIClientService

    LobbyState -> ServerController: broadcastLobbyUpdate(LobbyID)
    deactivate LobbyState

    activate ServerController
    ServerController -> RMIClientInterface: updateLobby(Lobby)
    deactivate ServerController

    activate RMIClientInterface
    RMIClientInterface -> RMIClientService: updateLobby(Lobby)
    deactivate RMIClientInterface

    activate RMIClientService
    RMIClientService -> ClientController: submitCPUTask()
    deactivate RMIClientService

else creating a game lobby
    ClientController -> RMIServerInterface : createLobby(PlayerNum, Totem)

    activate RMIServerInterface
    RMIServerInterface -> RMIServerService: createLobby(PlayerNum, Totem)
    deactivate RMIServerInterface

    activate RMIServerService
    RMIServerService -> ServerController: submitCPUTask()
    deactivate RMIServerService

    activate ServerController
    ServerController -> LobbyController: new LobbyController()
    ServerController -> LobbyController: add(Client, Player)
    ServerController -> RMIClientInterface: createLobby(Lobby)

    activate RMIClientInterface
    RMIClientInterface -> RMIClientService: createLobby(Lobby)
    deactivate RMIClientInterface

    activate RMIClientService
    RMIClientService -> ClientController: submitCPUTask()
    deactivate RMIClientService

    ServerController -> ServerController : broadcastLobbyAddition(Lobby)
    ServerController -> RMIClientInterface : addLobby(Lobby)
    deactivate ServerController

    activate RMIClientInterface
    RMIClientInterface -> RMIClientService: addLobby(Lobby)
    deactivate RMIClientInterface

    activate RMIClientService
    RMIClientService -> ClientController: submitCPUTask()
    deactivate RMIClientService
end

@enduml